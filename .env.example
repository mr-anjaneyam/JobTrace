# ==============================================================================
# JobTrace Environment Variables & Secrets
# ==============================================================================

# Web Server Port (defaults to 8000, set to 8089 or your preferred host port)
JOBTRACE_PORT=8089

# Telegram Bot (for daily opening alerts and weekly digests)
# 1. Message @BotFather on Telegram -> /newbot -> get your Bot Token
# 2. Message @userinfobot or check https://api.telegram.org/bot<TOKEN>/getUpdates -> get your Chat ID
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
TELEGRAM_CHAT_ID="your-telegram-chat-id-here"

# LLM Scoring API Keys (configure provider in config.yaml)
# Default provider: xkiro (Mistral Large 3)
XKIRO_API_KEY=""

# Optional alternative providers:
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
CURSOR_API_KEY=""
TYPESAFE_API_KEY=""

# Ollama server address if it is not on this machine (Docker sets host.docker.internal for you)
# OLLAMA_BASE_URL="http://localhost:11434"
