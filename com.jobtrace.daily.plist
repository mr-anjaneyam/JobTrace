<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobtrace.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DIR__/run.sh</string>
    <string>alert</string>
  </array>

  <!-- Daily at 09:30: checks watched company openings and sends Telegram alert -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__DIR__/alert.out.log</string>
  <key>StandardErrorPath</key><string>__DIR__/alert.err.log</string>
</dict>
</plist>
